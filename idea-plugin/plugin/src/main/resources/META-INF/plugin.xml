<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>io.github.keymusicman.sight.SightPlugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Sight</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/keymusicman">keymusicman</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p><b>Sight</b> turns your Jetpack Compose <code>@Preview</code> screens into an interactive
        navigation-flow graph, right inside the IDE.</p>
        <p>Annotate screens with <code>@SightScreen</code> and declare navigation with
        <code>@SightTransition</code>; the Sight Gradle plugin's KSP processor builds the graph, and
        this tool window renders it:</p>
        <ul>
          <li>Interactive canvas with pan, zoom and hover highlighting</li>
          <li>Real screen previews rendered via Layoutlib, with a per-screen state carousel</li>
          <li>Automatic layout of subgraphs, transitions and entry points</li>
        </ul>
        <p>See your whole app's flow at a glance, straight from the previews you already write.
        Requires the Sight Gradle plugin (<code>io.github.keymusicman.sight</code>). Apache-2.0.</p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.androidstudio</depends>
    <depends>org.jetbrains.plugins.gradle</depends>
    <depends>org.jetbrains.android</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <applicationListeners>
        <listener class="io.github.keymusicman.sight.plugin.PluginUnloadListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Sight"
                    factoryClass="io.github.keymusicman.sight.plugin.FlowToolWindowFactory"
                    anchor="bottom"
                    icon="/icons/sightToolWindow.svg"
                    canCloseContents="true"/>
        <projectService serviceImplementation="io.github.keymusicman.sight.plugin.PreviewConfigService"/>
        <applicationService serviceImplementation="io.github.keymusicman.sight.plugin.PluginSettingsService"/>
        <applicationService serviceImplementation="io.github.keymusicman.sight.plugin.TelemetryService"/>
        <applicationConfigurable parentId="tools"
                                 instance="io.github.keymusicman.sight.plugin.PluginSettingsConfigurable"
                                 id="io.github.keymusicman.sight.settings"
                                 displayName="Sight"/>
    </extensions>
</idea-plugin>