    { "subgraph": "main", "id": "transaction_details", "composable_fqn": "P.Tx" }
  ],
  "transitions": [
    { "source_fqn": "P.Main", "to_subgraph": "profile", "trigger": "profile_tap" },
    { "source_fqn": "P.Main", "to_screen": "transaction_details", "trigger": "transaction_tap" }
